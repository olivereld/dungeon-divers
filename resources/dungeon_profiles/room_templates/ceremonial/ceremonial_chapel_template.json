{
    "schema_version": 1,
    "id": "ceremonial_chapel",
    "display_name": "Ceremonial Chapel Template",
    "tags": ["ceremonial", "chapel", "worship", "focal"],
    "geometry": {
        "shape": { "allowed": ["chapel", "central_nave", "rectangle"] },
        "width": { "min": 8, "max": 16 },
        "depth": { "min": 10, "max": 18 },
        "area": { "min": 80, "max": 288 },
        "aspect_ratio": { "min": 0.5, "max": 1.2 }
    },
    "entrances": {
        "min": 1,
        "max": 3,
        "allowed_sides": ["south", "west", "east"],
        "allow_corner": false,
        "min_spacing": 3
    },
    "symmetry": {
        "required": true,
        "axis": "vertical"
    },
    "anchors": {
        "apse_altar": { "required": true, "location": "north_wall" },
        "pews_left": { "required": false, "location": "west_flank" },
        "pews_right": { "required": false, "location": "east_flank" }
    },
    "clearances": {
        "entrance": 2,
        "focal": 2,
        "circulation": 2,
        "walls": 0
    },
    "semantic_constraints": {
        "allowed_purposes": ["chapel", "sanctum", "royal_tomb"],
        "preferred_purposes": ["chapel"]
    }
}
