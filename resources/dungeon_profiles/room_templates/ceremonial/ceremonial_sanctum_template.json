{
    "schema_version": 1,
    "id": "ceremonial_sanctum",
    "display_name": "Ceremonial Sanctum Template",
    "tags": ["ceremonial", "sanctum", "sacred", "focal"],
    "geometry": {
        "shape": { "allowed": ["cruciform", "octagonal", "rectangle"] },
        "width": { "min": 8, "max": 16 },
        "depth": { "min": 8, "max": 16 },
        "area": { "min": 64, "max": 256 },
        "aspect_ratio": { "min": 0.6, "max": 1.6 }
    },
    "entrances": {
        "min": 1,
        "max": 3,
        "allowed_sides": ["south", "east", "west"],
        "allow_corner": false,
        "min_spacing": 3
    },
    "symmetry": {
        "required": true,
        "axis": "vertical"
    },
    "anchors": {
        "altar_focal": { "required": true, "location": "center" },
        "apse_focal": { "required": false, "location": "north_wall" }
    },
    "clearances": {
        "entrance": 2,
        "focal": 2,
        "circulation": 1,
        "walls": 0
    },
    "semantic_constraints": {
        "allowed_purposes": ["sanctum", "sacristy", "royal_tomb", "chapel"],
        "preferred_purposes": ["sanctum"]
    }
}
